{
  "name": "quizaipro-tailwind",
  "version": "1.0.0",
  "description": "Tailwind CSS build for QuizAIPro templates (run from this dir)",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./tailwind.input.css -o ../../static/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./tailwind.input.css -o ../../static/tailwind.css --watch",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "3.4.13"
  }
}
